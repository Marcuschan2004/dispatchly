DATABASE_URL=postgres://dispatchly:dispatchly@localhost:5433/dispatchly
PORT=3000
# Run the delivery worker inside the API process. Off by default so
# scripts/check-events.sh sees deliveries before anything sends them.
# RUN_WORKER=true
# Lets local scripts (scripts/check-events.sh) call the API without a key.
# Only honored when HOST is a loopback address; the server refuses to start
# otherwise. Remove it to try auth locally: npm run api-key -- create dev
AUTH_DISABLED=true
